# Environment of the container under test (docker run --env-file, see tests.yml).
# Test values only: Postgres is the CI service (as bobobidou_app, like in
# production), Google and OpenAI are the doubles of stubs.py, started by the tests
SECRET_KEY=e2e-secret-of-at-least-thirty-two-bytes-long
DATABASE_URL=postgresql://bobobidou_app:bobobidou-e2e@127.0.0.1:5432/postgres
PORT=8080

OPENAI_API_KEY=sk-e2e
# Read by the OpenAI SDK itself
OPENAI_BASE_URL=http://127.0.0.1:9999/openai/v1
DAILY_PHOTO_LIMIT=2

GOOGLE_CLIENT_ID=e2e-client-id
GOOGLE_CLIENT_SECRET=e2e-client-secret
GOOGLE_TOKEN_URL=http://127.0.0.1:9999/google/token
GOOGLE_USER_INFO_URL=http://127.0.0.1:9999/google/userinfo
GOOGLE_REVOKE_URL=http://127.0.0.1:9999/google/revoke
AUTH_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
