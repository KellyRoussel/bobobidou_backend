# Copy to .env for local development. On Cloud Run, the same variables are set
# on the service (secrets through Secret Manager, see docs/deploiement-gcp.md)

# Signs the JWTs and keys the photo counters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Backend connection, as the bobobidou_app role (Supabase pooler, session mode)
DATABASE_URL=postgresql://bobobidou_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Admin connection, only for the migrations (alembic). Never set on Cloud Run
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini-2024-07-18
# DAILY_PHOTO_LIMIT=5
# GLOBAL_DAILY_PHOTO_LIMIT=500

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The app name is appended: Google must accept <AUTH_REDIRECT_URI>/bobobidou
AUTH_REDIRECT_URI=http://localhost:8000/auth/callback
